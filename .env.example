# ThuocSi.vn Credentials
THUOCSI_USERNAME=your_username_here
THUOCSI_PASSWORD=your_password_here

# ChromeDriver path (optional, leave empty to use default)
CHROME_DRIVER_PATH=

# Schedule settings
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# Price comparison method: previous_day, week_average, fixed_price
PRICE_COMPARISON=previous_day

# Excel file path
EXCEL_FILE=./data/prices.xlsx
